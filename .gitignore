# Supabase CLI scratch state (version-check cache etc.). The CLI creates this
# inside whichever workdir it runs against — today packages/db/forward.
**/supabase/.temp/
# Opt-in eval artifacts. authoring-discovery.eval.ts writes to <cwd>/tmp/ only
# when run with --write-artifacts; filenames are content hashes, so the output
# is regenerable and never a source or fixture.
apps/web/tmp/

# Legacy read-identity key material for the SL-1 gateway prerequisite (TD-5):
# the Firestore service-account key files and the Atlas password file. For this
# bootstrap they sit in the working tree and are referenced by path, and these
# patterns keep them out of history. That is a decision about this specific
# material, not a general secrets policy. `git clean -fdx` removes ignored files
# too, so keep a copy outside the repo.
gu-os-sl1-reader.*.json
*.password.txt

# Raw console transcripts of eval batches and smoke runs. The evidence is the
# JSON artifact under docs/.../evidence/, which is committed; this is the
# scrollback that produced it.
.evallogs/
